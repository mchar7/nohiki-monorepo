{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Etc/UTC",
  "labels": ["dependencies"],
  "automerge": false,
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "prBodyColumns": ["Package", "Type", "Update", "Change", "Pending"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**/!(Dockerfile.api-runner)",
    "**/__fixtures__/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "enabledManagers": [
    "npm",
    "pep621",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "helmv3",
    "helm-values",
    "flux",
    "kubernetes",
    "custom.regex",
    "nix"
  ],
  "pep621": {
    "enabled": true
  },
  "nix": {
    "enabled": true
  },
  "flux": {
    "managerFilePatterns": ["/^infra\\/k8s\\/gitops\\/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^infra\\/k8s\\/.+\\/values\\.ya?ml$/", "/^infra\\/k8s\\/helm\\/values\\.local\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^infra\\/k8s\\/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      // why: pnpm is duplicated across the package manager declaration, container builds, and the Nix toolchain.
      "customType": "regex",
      "managerFilePatterns": [
        "/^typescript\\/apps\\/frontend\\/Dockerfile(?:\\.playwright-runner)?$/",
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "npm install --global pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "pname\\s*=\\s*\"pnpm\";\\s*version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";",
        "registry\\.npmjs\\.org/pnpm/-/pnpm-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tgz"
      ],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      // why: the Playwright test package and runner image must use the same browser build.
      "customType": "regex",
      "managerFilePatterns": ["/^typescript\\/apps\\/frontend\\/Dockerfile\\.playwright-runner$/"],
      "matchStrings": [
        "mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)-noble@sha256:[0-9a-f]{64}"
      ],
      "depNameTemplate": "@playwright/test",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Require a human dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      // why: workspace members are never published to PyPI, so a lookup can only fail.
      "description": "Disable PyPI lookups for uv workspace members",
      "matchDatasources": ["pypi"],
      "matchPackageNames": [
        "ast-explorer",
        "bff-service",
        "calibrate-skill-thresholds",
        "ci-checks",
        "doc-content-service",
        "doc-process-service",
        "doc-template-service",
        "gitops-contract-tests",
        "health-check",
        "job-correlation-evaluation-service",
        "job-embedding-finetuning",
        "job-ingest-discovery-service",
        "job-ingest-enrichment-service",
        "job-ingest-schedule-service",
        "job-query-composition-service",
        "job-storage-service",
        "llm-benchmark",
        "ml-compute-service",
        "ml-gateway-service",
        "nohiki-common-exceptions",
        "nohiki-core-settings",
        "nohiki-db-utils",
        "nohiki-domain-models",
        "nohiki-embedding-client",
        "nohiki-fastapi-utils",
        "nohiki-finance",
        "nohiki-geo-utils",
        "nohiki-integration-tests",
        "nohiki-kafka-client",
        "nohiki-llm-client",
        "nohiki-ml-core",
        "nohiki-ml-manifest",
        "nohiki-observability",
        "nohiki-qdrant-client",
        "nohiki-redis-utils",
        "nohiki-s3-client",
        "nohiki-scaffold",
        "nohiki-test-utils",
        "notification-service",
        "qdrant-init",
        "skill-graph-service",
        "skill-semantic-analysis",
        "snapshot-refresh-job",
        "sys-tick-job",
        "tailor",
        "user-auth-service",
        "user-entitlement-service",
        "user-pref-service",
        "user-upload-service"
      ],
      "enabled": false
    },
    {
      // why: the Skylos pin must not be bumped, so its git-refs lookup is intentionally disabled.
      "description": "Disable lookups for the fixed Skylos pin",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["ssh://git@github.com/mchar7/skylos"],
      "enabled": false
    },
    {
      // why: release inactivity cannot distinguish a finished package from an abandoned one.
      "description": "Disable abandonment detection for intentionally finished packages",
      "matchPackageNames": [
        "@codemirror/theme-one-dark",
        "clsx"
      ],
      "abandonmentThreshold": null
    },
    {
      // why: active upstream development makes the default release-inactivity window a false positive.
      "description": "Extend abandonment detection for actively developed infrequent-release packages",
      "matchPackageNames": [
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "@testing-library/user-event",
        "argon2-cffi",
        "class-variance-authority",
        "cmdk",
        "html2text",
        "jinja2",
        "pytest-timeout",
        "pytest-xdist",
        "python-jobspy",
        "semver",
        "vitest-axe"
      ],
      "abandonmentThreshold": "4 years"
    },
    {
      "description": "Group pnpm minor and patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pnpm minor and patch"
    },
    {
      "description": "Group uv minor and patch updates",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "uv minor and patch"
    },
    {
      "description": "Group action updates but retain individual major approvals",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions minor, patch, and digest"
    },
    {
      "description": "Group container updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker minor, patch, and digest"
    },
    {
      "description": "Group Helm/Kubernetes updates",
      "matchManagers": ["helmv3", "helm-values", "flux", "kubernetes"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Kubernetes and Helm minor, patch, and digest"
    },
    {
      "description": [
        "Never inject a digest into a helm-values tag: several image blocks under infra/k8s compose the",
        "digest in a sibling digest:/sha: key, whose chart renders repository:<tag>@sha256:<sibling>, so a",
        "digest inside tag yields an unpullable double-digest reference. Entries whose tag already reads",
        "<version>@sha256:<digest> keep receiving digest updates because they carry a currentDigest.",
        "This must be a packageRule: manager-scoped config is merged before packageRules are applied, so it",
        "cannot override docker:pinDigests from config:best-practices."
      ],
      "matchManagers": ["helm-values"],
      "pinDigests": false
    },
    {
      // cause: helm-values ignores sibling digest/sha keys, so updating these tags alone leaves stale image pins,
      // exit: remove this after the CPR trigger gives sibling digests a native owner through Flux image-automation,
      "description": "Keep separate-key Helm image pins under manual pair ownership",
      "matchManagers": ["helm-values"],
      "matchFileNames": ["infra/k8s/helm/values.yaml"],
      "matchPackageNames": [
        "prometheus/prometheus",
        "prometheus/alertmanager",
        "docker.io/grafana/alloy",
        "quay.io/prometheus-operator/prometheus-config-reloader"
      ],
      "enabled": false
    },
    {
      "description": "Group Nix updates",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Nix minor, patch, and digest"
    },
    {
      // why: every pnpm consumer must move in the same Renovate pull request.
      "description": "Keep duplicate pnpm declarations aligned",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm version parity"
    },
    {
      // why: the Playwright package and runner image must move in the same Renovate pull request.
      "description": "Keep duplicate Playwright declarations aligned",
      "matchPackageNames": ["@playwright/test"],
      "groupName": "Playwright version parity"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": false
}
