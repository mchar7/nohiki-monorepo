{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Etc/UTC",
  "labels": ["dependencies"],
  "automerge": false,
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "prBodyColumns": ["Package", "Type", "Update", "Change", "Pending"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**/!(Dockerfile.api-runner|pyproject.toml|test_eso_ownership.py|test_declarative_foundation.py)",
    "**/__fixtures__/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"]
  },
  "enabledManagers": [
    "npm",
    "pep621",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "gradle",
    "gradle-wrapper",
    "helmv3",
    "helm-values",
    "flux",
    "kubernetes",
    "custom.regex",
    "terraform",
    "nix"
  ],
  "pep621": {
    "enabled": true
  },
  "nix": {
    "enabled": true
  },
  "flux": {
    "managerFilePatterns": ["/^infra\\/k8s\\/gitops\\/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^infra\\/k8s\\/.+\\/values\\.ya?ml$/", "/^infra\\/k8s\\/helm\\/values\\.local\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^infra\\/k8s\\/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      // why: pnpm is duplicated across the package manager declaration, container builds, and the Nix toolchain.
      "customType": "regex",
      "managerFilePatterns": [
        "/^typescript\\/apps\\/frontend\\/Dockerfile(?:\\.playwright-runner)?$/",
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "npm install --global pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "pname\\s*=\\s*\"pnpm\";\\s*version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\";",
        "registry\\.npmjs\\.org/pnpm/-/pnpm-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tgz"
      ],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      // why: the Playwright test package and runner image must use the same browser build.
      "customType": "regex",
      "managerFilePatterns": ["/^typescript\\/apps\\/frontend\\/Dockerfile\\.playwright-runner$/"],
      "matchStrings": [
        "mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)-noble@sha256:[0-9a-f]{64}"
      ],
      "depNameTemplate": "@playwright/test",
      "datasourceTemplate": "npm"
    },
    {
      // why: the Java toolchain major must stay aligned between the Gradle compile target and the pinned Nix JDK.
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/",
        "/^jvm\\/nohiki-wal-router-smt\\/build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "jdk\\s*=\\s*pkgs\\.jdk(?<currentValue>\\d+);",
        "JavaLanguageVersion\\.of\\((?<currentValue>\\d+)\\)"
      ],
      "depNameTemplate": "java-jdk",
      "packageNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^(?<version>\\d+)"
    },
    {
      // why: the Nix Gradle version must move with the wrapper and container builder pins.
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "gradle\\s*=\\s*pkgs\\.gradle-packages\\.mkGradle\\s*\\{\\s*version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\";"
      ],
      "depNameTemplate": "gradle",
      "packageNameTemplate": "gradle",
      "datasourceTemplate": "gradle-version"
    },
    {
      // why: Spotless does not expose its formatter tool pin to Renovate's Gradle manager.
      "customType": "regex",
      "managerFilePatterns": ["/^jvm\\/nohiki-wal-router-smt\\/build\\.gradle\\.kts$/"],
      "matchStrings": [
        "googleJavaFormat\\(\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\)"
      ],
      "depNameTemplate": "com.google.googlejavaformat:google-java-format",
      "packageNameTemplate": "com.google.googlejavaformat:google-java-format",
      "datasourceTemplate": "maven"
    },
    {
      // why: the scaffold template is the canonical Python image pin but is not named Dockerfile.
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts\\/util\\/scaffold\\/src\\/nohiki_scaffold\\/templates\\/service\\/Dockerfile\\.j2$/"
      ],
      "matchStrings": [
        "public\\.ecr\\.aws/docker/library/python:(?<currentValue>\\d+\\.\\d+\\.\\d+)-slim@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "depNameTemplate": "public.ecr.aws/docker/library/python",
      "datasourceTemplate": "docker"
    },
    {
      // why: these charts split the Docker tag and digest into sibling keys.
      "customType": "regex",
      "managerFilePatterns": ["/^infra\\/k8s\\/helm\\/values\\.yaml$/"],
      "matchStrings": [
        "(?<indentation>[ \\t]*)registry:\\s*(?<registry>docker\\.io|quay\\.io)\\s+repository:\\s*(?<depName>(?:grafana/alloy|prometheus-operator/prometheus-config-reloader))\\s+tag:\\s*(?<currentValue>v?[0-9][A-Za-z0-9_.-]*)\\s+digest:\\s*(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "packageNameTemplate": "{{{registry}}}/{{{depName}}}",
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "{{{indentation}}}registry: {{{registry}}}\n{{{indentation}}}repository: {{{depName}}}\n{{{indentation}}}tag: {{{newValue}}}\n{{{indentation}}}digest: {{{newDigest}}}"
    },
    {
      // why: kube-prometheus-stack expects a raw digest in sha rather than a sha256-prefixed value.
      "customType": "regex",
      "managerFilePatterns": ["/^infra\\/k8s\\/helm\\/values\\.yaml$/"],
      "matchStrings": [
        "(?<indentation>[ \\t]*)repository:\\s*(?<depName>prometheus/(?:prometheus|alertmanager))\\s+tag:\\s*(?<currentValue>v?[0-9][A-Za-z0-9_.-]*)\\s+sha:\\s*(?<currentDigest>[0-9a-f]{64})"
      ],
      "packageNameTemplate": "quay.io/{{{depName}}}",
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "{{{indentation}}}repository: {{{depName}}}\n{{{indentation}}}tag: {{{newValue}}}\n{{{indentation}}}sha: {{{replace '^sha256:' '' newDigest}}}"
    },
    {
      // why: the runtime, Strimzi resource, and Kafka Connect template must target one broker version.
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra\\/k8s\\/helm\\/values(?:\\.local)?\\.yaml$/",
        "/^infra\\/k8s\\/helm\\/templates\\/strimzi-kafka-connect\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s*\\{\\{[^\\n\"]*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "versioningTemplate": "maven"
    },
    {
      // why: setup-opentofu's tool version is separate from the action revision.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/cd_(?:deploy-to|destroy)-aks_nohiki\\.yml$/"
      ],
      "matchStrings": ["tofu_version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases"
    },
    {
      // why: the Kafka Connect README repeats its Gradle builder for reproducible local commands.
      "customType": "regex",
      "managerFilePatterns": ["/^infra\\/k8s\\/kafka-connect\\/smt\\/README\\.md$/"],
      "matchStrings": [
        "gradle:(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)-jdk\\d+@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "depNameTemplate": "gradle",
      "datasourceTemplate": "docker"
    },
    {
      // why: Helm build metadata must move with the Debezium Connect image.
      "customType": "regex",
      "managerFilePatterns": ["/^infra\\/k8s\\/helm\\/values\\.yaml$/"],
      "matchStrings": ["debeziumVersion:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+\\.Final)"],
      "depNameTemplate": "quay.io/debezium/connect",
      "datasourceTemplate": "docker"
    },
    {
      // why: the compatibility override is a pip input outside a PEP 621 project.
      "customType": "regex",
      "managerFilePatterns": ["/^semgrep-overrides\\.txt$/"],
      "matchStrings": ["semgrep==(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "semgrep",
      "datasourceTemplate": "pypi"
    },
    {
      // why: the test ledger attests the exact vendored External Secrets chart bytes.
      "customType": "regex",
      "managerFilePatterns": ["/^scripts\\/ci\\/tests\\/test_eso_ownership\\.py$/"],
      "matchStrings": [
        "_ESO_CHART_LEDGER = \\(\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\", \"(?<currentDigest>[0-9a-f]{64})\"\\)"
      ],
      "depNameTemplate": "external-secrets",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://charts.external-secrets.io"
    },
    {
      // why: the KEDA test ledger attests the exact vendored chart bytes.
      "customType": "regex",
      "managerFilePatterns": ["/^scripts\\/ci\\/tests\\/test_declarative_foundation\\.py$/"],
      "matchStrings": [
        "\"keda-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tgz\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "depNameTemplate": "keda",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://kedacore.github.io/charts"
    },
    {
      // why: the CloudNativePG test ledger attests the exact vendored chart bytes.
      "customType": "regex",
      "managerFilePatterns": ["/^scripts\\/ci\\/tests\\/test_declarative_foundation\\.py$/"],
      "matchStrings": [
        "\"cloudnative-pg-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tgz\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "depNameTemplate": "cloudnative-pg",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://cloudnative-pg.github.io/charts"
    }
  ],
  "packageRules": [
    {
      "description": "Require a human dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      // why: config:best-practices manager settings are overridden at package-rule precedence.
      "description": "Enable Gradle dependencies and wrapper updates",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "enabled": true
    },
    {
      // why: the SMT must compile against the Kafka line shipped by the Debezium runtime image.
      "description": "Keep Kafka Connect APIs aligned with the 4.3 runtime",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.apache.kafka:connect-api",
        "org.apache.kafka:connect-transforms"
      ],
      "allowedVersions": "/^4\\.3\\./"
    },
    {
      // why: one PR must move the Nix JDK and Gradle language toolchain together.
      "description": "Keep duplicate JDK major declarations aligned",
      "matchPackageNames": ["java-jdk"],
      "groupName": "JDK major parity"
    },
    {
      // why: the wrapper, Nix package, and builder image must use one Gradle release.
      "description": "Keep Gradle toolchain declarations aligned",
      "matchPackageNames": ["gradle"],
      "groupName": "Gradle toolchain parity"
    },
    {
      // why: workspace members are never published to PyPI, so a lookup can only fail.
      "description": "Disable PyPI lookups for uv workspace members",
      "matchDatasources": ["pypi"],
      "matchPackageNames": [
        "ast-explorer",
        "bff-service",
        "calibrate-skill-thresholds",
        "ci-checks",
        "doc-content-service",
        "doc-process-service",
        "doc-template-service",
        "gitops-contract-tests",
        "health-check",
        "job-correlation-evaluation-service",
        "job-embedding-finetuning",
        "job-ingest-discovery-service",
        "job-ingest-enrichment-service",
        "job-ingest-schedule-service",
        "job-query-composition-service",
        "job-storage-service",
        "llm-benchmark",
        "ml-compute-service",
        "ml-gateway-service",
        "nohiki-common-exceptions",
        "nohiki-core-settings",
        "nohiki-db-utils",
        "nohiki-domain-models",
        "nohiki-embedding-client",
        "nohiki-fastapi-utils",
        "nohiki-finance",
        "nohiki-geo-utils",
        "nohiki-integration-tests",
        "nohiki-kafka-client",
        "nohiki-llm-client",
        "nohiki-ml-core",
        "nohiki-ml-manifest",
        "nohiki-observability",
        "nohiki-qdrant-client",
        "nohiki-redis-utils",
        "nohiki-s3-client",
        "nohiki-scaffold",
        "nohiki-test-utils",
        "notification-service",
        "qdrant-init",
        "skill-graph-service",
        "skill-semantic-analysis",
        "snapshot-refresh-job",
        "sys-tick-job",
        "tailor",
        "user-auth-service",
        "user-entitlement-service",
        "user-pref-service",
        "user-upload-service"
      ],
      "enabled": false
    },
    {
      // why: the Skylos pin must not be bumped, so its git-refs lookup is intentionally disabled.
      "description": "Disable lookups for the fixed Skylos pin",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["ssh://git@github.com/mchar7/skylos"],
      "enabled": false
    },
    {
      // why: release inactivity cannot distinguish a finished package from an abandoned one.
      "description": "Disable abandonment detection for intentionally finished packages",
      "matchPackageNames": [
        "@codemirror/theme-one-dark",
        "clsx"
      ],
      "abandonmentThreshold": null
    },
    {
      // why: active upstream development makes the default release-inactivity window a false positive.
      "description": "Extend abandonment detection for actively developed infrequent-release packages",
      "matchPackageNames": [
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "@testing-library/user-event",
        "argon2-cffi",
        "class-variance-authority",
        "cmdk",
        "html2text",
        "jinja2",
        "pytest-timeout",
        "pytest-xdist",
        "python-jobspy",
        "semver",
        "vitest-axe"
      ],
      "abandonmentThreshold": "4 years"
    },
    {
      "description": "Group pnpm minor and patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pnpm minor and patch"
    },
    {
      "description": "Group uv minor and patch updates",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "uv minor and patch"
    },
    {
      "description": "Group action updates but retain individual major approvals",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions minor, patch, and digest"
    },
    {
      "description": "Group container updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker minor, patch, and digest"
    },
    {
      "description": "Group custom Docker pin updates with native container updates",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker minor, patch, and digest"
    },
    {
      "description": "Group custom Helm ledgers with native chart updates",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Kubernetes and Helm minor, patch, and digest"
    },
    {
      "description": "Keep images shared by Compose and Helm in one pull request",
      "matchPackageNames": [
        "docker.io/grafana/mimir",
        "quay.io/prometheus/prometheus",
        "quay.io/docling-project/docling-serve-cpu"
      ],
      "groupName": "Compose and Helm image parity"
    },
    {
      "description": "Group Terraform provider and module updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Terraform minor, patch, and digest"
    },
    {
      "description": "Group Helm/Kubernetes updates",
      "matchManagers": ["helmv3", "helm-values", "flux", "kubernetes"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Kubernetes and Helm minor, patch, and digest"
    },
    {
      "description": [
        "Never inject a digest into a helm-values tag: several image blocks under infra/k8s compose the",
        "digest in a sibling digest:/sha: key, whose chart renders repository:<tag>@sha256:<sibling>, so a",
        "digest inside tag yields an unpullable double-digest reference. Entries whose tag already reads",
        "<version>@sha256:<digest> keep receiving digest updates because they carry a currentDigest.",
        "This must be a packageRule: manager-scoped config is merged before packageRules are applied, so it",
        "cannot override docker:pinDigests from config:best-practices."
      ],
      "matchManagers": ["helm-values"],
      "pinDigests": false
    },
    {
      // cause: helm-values ignores sibling digest/sha keys, so updating these tags alone leaves stale image pins,
      // exit: remove this after the CPR trigger gives sibling digests a native owner through Flux image-automation,
      "description": "Keep separate-key Helm image pins under manual pair ownership",
      "matchManagers": ["helm-values"],
      "matchFileNames": ["infra/k8s/helm/values.yaml"],
      "matchPackageNames": [
        "prometheus/prometheus",
        "prometheus/alertmanager",
        "docker.io/grafana/alloy",
        "quay.io/prometheus-operator/prometheus-config-reloader"
      ],
      "enabled": false
    },
    {
      // why: vendored chart bytes and their reviewed SHA-256 ledgers must be refreshed by the owner.
      "description": "Keep integrity-attested vendored charts owner-gated",
      "matchPackageNames": [
        "agentgateway",
        "agentgateway-crds",
        "kgateway",
        "kgateway-crds"
      ],
      "enabled": false
    },
    {
      // why: uv changes require four Nix fetch hashes plus every runtime image digest.
      "description": "Keep the uv toolchain ledger owner-gated",
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "enabled": false
    },
    {
      // why: Lefthook changes require a Git revision and two Nix fixed-output hashes.
      "description": "Keep the Lefthook source ledger owner-gated",
      "matchPackageNames": ["lefthook"],
      "enabled": false
    },
    {
      "description": "Group Nix updates",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Nix minor, patch, and digest"
    },
    {
      // why: every pnpm consumer must move in the same Renovate pull request.
      "description": "Keep duplicate pnpm declarations aligned",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm version parity"
    },
    {
      // why: the Playwright package and runner image must move in the same Renovate pull request.
      "description": "Keep duplicate Playwright declarations aligned",
      "matchPackageNames": ["@playwright/test"],
      "groupName": "Playwright version parity"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": false
}
