# Nohiki direnv configuration
# Run 'direnv allow' to activate. Requires nix-direnv for caching.
#
# Available shells:
#   use flake .#backend   - Python only
#   use flake .#frontend  - Node.js only
#   use flake .#infra     - kubectl, helm, terraform
#   use flake .#k8s       - kubectl/helm/k9s tooling (bring your own cluster)

# Repository root, derived from this file's location so the value is correct
# no matter which subdirectory direnv was triggered from.
PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" >/dev/null 2>&1 && pwd -P)"
export PROJECT_ROOT

# Watch Nix files so direnv automatically re-evaluates when inputs change
watch_file flake.nix
watch_file flake.lock

# Only evaluate Nix flake if Nix is installed, preventing blocks for non-Nix developers
if has nix; then
  if has nix_direnv_version; then
    nix_direnv_version 3.0.0 2>/dev/null || true
  fi
  use flake
fi

# Local dev defaults
export LOG_LEVEL="${LOG_LEVEL:-INFO}"
export ENVIRONMENT="${ENVIRONMENT:-development}"

export DATABASE_HOST="${DATABASE_HOST:-localhost}"
export DATABASE_PORT="${DATABASE_PORT:-5432}"
export DATABASE_NAME="${DATABASE_NAME:-nohiki_db}"
export DATABASE_USER="${DATABASE_USER:-postgres}"
export DATABASE_PASSWORD="${DATABASE_PASSWORD:-postgres}"
export DATABASE_URL="${DATABASE_URL:-postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}}"

export REDIS_URL="${REDIS_URL:-redis://localhost:6379/0}"
export KAFKA_BOOTSTRAP_SERVERS="${KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}"

export JWT_SECRET_KEY="${JWT_SECRET_KEY:-local-dev-jwt-secret-key-change-in-prod}"
export OTEL_ENABLED="${OTEL_ENABLED:-false}"

# Load .env.local if present (gitignored)
if [ -f ".env.local" ]; then
  dotenv .env.local 2>/dev/null || source_env .env.local 2>/dev/null || {
    set -a; source .env.local; set +a
  }
fi

# Load local development secrets if present. Layout matches
# infra/shared/secrets/README.md; every read is quoted and skipped silently
# when the file is absent, so nothing is printed and no value leaks.
SECRETS_DIR="${PROJECT_ROOT}/infra/shared/secrets"
if [ -d "$SECRETS_DIR" ]; then
  read_secret() {
    local file="$SECRETS_DIR/$2"
    [ -f "$file" ] && export "$1=$(cat "$file")"
  }
  read_secret OPENAI_API_KEY "llm/provider/api_keys/openai"
  read_secret OPENROUTER_API_KEY "llm/provider/api_keys/openrouter"
  read_secret NOTIFICATION_EMAIL__API_KEY "email/api_key"
  unset -f read_secret
fi

PATH_add ".venv/bin"
PATH_add "typescript/apps/frontend/node_modules/.bin"
