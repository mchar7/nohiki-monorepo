{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@nohiki/biome-config/biome.json"],
  "files": {
    "includes": ["src/**/*"]
  },
  "overrides": [
    {
      // Cloudflare/BFF payloads include snake_case keys. Keep naming strict for
      // local identifiers while allowing external object/type property shapes to
      // match their wire contracts exactly.
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
                  },
                  {
                    "selector": { "kind": "typeProperty" },
                    "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Cloudflare Workers require the module entrypoint to default-export the
      // worker handler object. Keep noDefaultExport enabled everywhere else.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
