# syntax=docker/dockerfile:1.26@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
FROM docker.io/library/node:26.5.1-alpine@sha256:221f4d1edb150c0ddf3c61c1f053cd3a59ee0fe42f54cb687a7db24e97da6c46 AS dependencies

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /workspace
RUN npm install --global pnpm@11.17.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY typescript/apps/frontend/package.json typescript/apps/frontend/package.json
COPY typescript/libs/biome-config/package.json typescript/libs/biome-config/package.json
COPY typescript/libs/tsconfig/package.json typescript/libs/tsconfig/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter nohiki-frontend...
COPY typescript/apps/frontend typescript/apps/frontend
COPY typescript/libs/biome-config typescript/libs/biome-config
COPY typescript/libs/tsconfig typescript/libs/tsconfig

FROM mcr.microsoft.com/playwright:v1.62.0-noble@sha256:baed2032d533817f3dbe6425de795788430ba345e819a1201337009ba17c9d07

RUN npm install --global pnpm@11.17.0
WORKDIR /workspace
COPY --from=dependencies --chown=pwuser:pwuser /workspace /workspace
USER pwuser
ENV CI=true E2E_BASE_URL=http://nohiki.localhost
ENTRYPOINT ["node", "typescript/apps/frontend/e2e/run-k8s-verification.mjs"]
