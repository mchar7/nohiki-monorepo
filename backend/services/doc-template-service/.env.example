# Environment
ENV=development  # Use "production" for production mode

# API settings
PROJECT_NAME="Document Generator API"
API_V1_PREFIX=/api/v1

# Gotenberg service settings
GOTENBERG_URL=http://gotenberg:3000

# Size limits (in bytes)
MAX_TEMPLATE_SIZE=204800  # 200 KB
MAX_SCHEMA_SIZE=102400    # 100 KB

# Timeouts (in seconds)
REQUEST_TIMEOUT_S=10

# Cache settings
CACHE_MAX_ITEMS=128

# CORS settings (comma-separated list for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173

# Logging settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
