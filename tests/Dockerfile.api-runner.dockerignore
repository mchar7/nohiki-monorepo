# Explicit context contract for tests/Dockerfile.api-runner. The Dockerfile enumerates its COPY
# roots; this allow-list is what bounds the effective context, so an input absent here cannot reach
# the build and is not an image ownership input either.
**
!pyproject.toml
!uv.lock
!backend/libs/**
!docs/api/nohiki.openapi.json
!scripts/util/health_check/**
!tests/**

# Re-exclusions inside the admitted trees.
# A uv workspace has exactly one lock, at the root; a nested one is stray local output.
tests/uv.lock
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.egg-info/
**/.pytest_cache/
**/.coverage
**/coverage.xml
