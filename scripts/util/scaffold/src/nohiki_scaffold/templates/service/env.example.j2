ENVIRONMENT=development
LOG_LEVEL=INFO

{% if has_http %}
{{ env_prefix }}HOST=0.0.0.0
{{ env_prefix }}PORT=8000
{% endif %}
{% if database.enabled %}
{{ env_prefix }}DATABASE__DSN=postgresql://nohiki:CHANGE_ME_postgres@localhost:5432/nohiki
{{ env_prefix }}DATABASE__SCHEMA_NAME={{ database.schema_name }}
{% endif %}
{% if kafka.role.value != "none" %}
{{ env_prefix }}KAFKA__BOOTSTRAP_SERVERS=localhost:29092
{{ env_prefix }}KAFKA__SCHEMA_REGISTRY_URL=http://localhost:8081
{{ env_prefix }}KAFKA__CONSUMER_GROUP={{ service_name }}
{% endif %}
{% if redis.enabled %}
{{ env_prefix }}REDIS__URL=redis://localhost:6379/0
{% endif %}
{% if s3.enabled %}
{{ env_prefix }}S3__ENDPOINT_URL=http://localhost:9000
{{ env_prefix }}S3__ACCESS_KEY_ID=CHANGE_ME_minio_access_key
{{ env_prefix }}S3__SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
{{ env_prefix }}S3__BUCKET_NAME=nohiki-{{ service_name }}
{% endif %}
{% if ml.manifest %}
{{ env_prefix }}MANIFEST_PATH=/etc/nohiki/manifest.yaml
{% endif %}
{% if ml.llm.enabled %}
{{ ml.llm.api_key_env or 'CHANGE_ME_API_KEY' }}=CHANGE_ME
{% endif %}
