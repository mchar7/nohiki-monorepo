# direnv / NixOS
.direnv/

# Local environment overrides
.env
.env.local
infra/shared/secrets/*
!infra/shared/secrets/README.md
lefthook-local.yml

# Caches and artifacts
*.py[cod]
*$py.class
**/.cache
**__pycache__/
.ruff_cache/
.pytest_cache/

# Terraform misc
**/.terraform/

# Helm dependency contracts: vendor umbrella archives, ignore subchart build output.
infra/k8s/helm/charts/**/charts/
infra/k8s/helm-foundation/charts/**/charts/
!infra/k8s/helm/charts/*.tgz
!infra/k8s/helm-foundation/charts/*.tgz

# Terraform private variables
infra/terraform/*.auto.tfvars
infra/terraform/private.tfvars
infra/terraform/backend.tfvars
infra/terraform/terraform.tfvars

# Virtual environments
.venv/

# Node.js modules
node_modules/

# Distribution / packaging
dist/
build/
*.egg-info

# Test / coverage / code quality scanner reports
htmlcov/
.coverage
.coverage.*
*coverage.xml
**/coverage/
coverage.json
**/coverage*.json
.scannerwork

# Test failure snapshot artifacts (runtime debugging output, never committed)
**/tests/integration/failures/
**/tests/**/failures/

# Skylos fixture analysis tool output
.skylos_unused_fixtures.json
**/.skylos/
!/.skylos/
/.skylos/*
!/.skylos/baseline.json

# Lock files (all except workspace-level roots)
*.lock
*.lock.*

# Allow only workspace-root lock files for reproducibility
!/uv.lock
!/flake.lock
!/pnpm-lock.yaml
!/proto/buf.lock
!/infra/terraform/.terraform.lock.hcl
!/infra/terraform/bootstrap/.terraform.lock.hcl
!/infra/k8s/helm/Chart.lock
!/infra/k8s/helm-foundation/Chart.lock

# Editor directories and files - personal local settings only
.idea/
.vscode/

# Cloudflare Worker local state / secrets
**/.wrangler/
**/.dev.vars*
!**/.dev.vars.example

# OS specific
.DS_Store
*.kate-swp

# Local repository state
.local/
infra/k8s/helm/values.secrets.yaml

# ─── Generated / runtime output ──────────────────────────────────────────────

# Generated document output (PDFs, images rendered by templates)
output/
*.pdf
*.png

# ML model binary artifacts (use model registry or Git LFS for these)
*.safetensors
*.safetensors.index.json
*.joblib
# 128-byte runtime calibrator; the L2R model it pairs with is already tracked
!models/l2r/calibrator.joblib
*.7z
*.onnx
*.pt
*.pth

# ML model directories - keep only runtime dependencies + metadata
models/job_finetune/
models/l2r/training_data/

# ML data pipeline outputs (generated by training/evaluation scripts)
*.parquet
data/l2r_training/
data/tabiya/

# Nix flake result symlink (standard Nix practice - do NOT delete, just ignore)
result

# Transient test/debug output
test_results.txt
test_mig_failures.txt

infra/compose/.nohiki-compose-*
# Benchmark results
scripts/benchmark/results/

# MLflow tracking artifacts
mlruns/

# Local tool caches
.pylate-local
skills-lock.json

# Frontend build/test artifacts
*.log
*.sw?
typescript/apps/frontend/e2e/.output/
typescript/apps/frontend/test-results/
