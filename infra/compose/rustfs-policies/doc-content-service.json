{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSourceDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-attachments/*"
      ]
    },
    {
      "Sid": "ListSourceBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-attachments"
      ]
    },
    {
      "Sid": "ManageTailoredDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-tailored-docs/*"
      ]
    },
    {
      "Sid": "ListTailoredBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-tailored-docs"
      ]
    }
  ]
}
