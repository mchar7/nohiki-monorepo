{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageMLflowArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-mlflow-artifacts/*"
      ]
    },
    {
      "Sid": "ListMLflowBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-mlflow-artifacts"
      ]
    }
  ]
}
