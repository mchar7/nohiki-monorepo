{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageMLArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-ml-artifacts/*"
      ]
    },
    {
      "Sid": "ListMLArtifactsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-ml-artifacts"
      ]
    }
  ]
}
