{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTemplateDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-templates/*"
      ]
    },
    {
      "Sid": "ListTemplatesBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::nohiki-templates"
      ]
    }
  ]
}
