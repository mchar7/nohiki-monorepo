# Nohiki Docker Compose environment. Copy to .env and adjust.
# Secrets are not stored here; see infra/shared/secrets/README.md.

COMPOSE_PROJECT_NAME=nohiki
COMPOSE_BAKE=true

# Non-secret config
SERVICE_VERSION=0.1.0
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:8000
GF_USERS_ALLOW_SIGN_UP=false

# The current openai:* model IDs are private OpenAI-compatible routes, not
# public OpenAI model names. Set their HTTPS API root, including the /v1 suffix.
# For a local proxy that exposes only HTTP, copy this file to .env and set
# NOHIKI_ALLOW_HTTP_LLM_LOCAL=1. The opt-in is accepted only when every resolved
# endpoint address is loopback or RFC1918; external HTTP remains forbidden.
NOHIKI_LLM_OPENAI_BASE_URL=
# NOHIKI_ALLOW_HTTP_LLM_LOCAL=1
# Set only when a native anthropic:* model is added. Use its HTTPS origin
# without a /v1 suffix; never reuse the OpenAI-compatible route.
# NOHIKI_LLM_ANTHROPIC_BASE_URL=

# Host port mapping. Every published port is host-facing only; internal service
# DNS and ports are fixed. Override to run two checkouts side by side without
# collisions. NOHIKI_HOST_IP=0.0.0.0 exposes beyond loopback. Values shown are
# the defaults.
NOHIKI_HOST_IP=127.0.0.1

# Edge gateway
NOHIKI_PORT_TRAEFIK_HTTP=8000
NOHIKI_PORT_TRAEFIK_HTTPS=8443
NOHIKI_PORT_TRAEFIK_DASHBOARD=8080

# Data stores
NOHIKI_PORT_POSTGRES=5432
NOHIKI_PORT_VALKEY=6379
NOHIKI_PORT_QDRANT_REST=6333
NOHIKI_PORT_QDRANT_GRPC=6334
NOHIKI_PORT_RUSTFS_API=9002
NOHIKI_PORT_RUSTFS_CONSOLE=9003

# Kafka
NOHIKI_PORT_KAFKA=29092
NOHIKI_PORT_KAFKA_CONNECT=8083

# Document tooling
NOHIKI_PORT_GOTENBERG=3000
NOHIKI_PORT_DOCLING=5001

# MLflow
NOHIKI_PORT_MLFLOW=5000

# dev profile (pgAdmin, Kafka UI)
NOHIKI_PORT_PGADMIN=5050
NOHIKI_PORT_KAFKA_UI=8082

# observability profile
NOHIKI_PORT_GRAFANA=3001
NOHIKI_PORT_PROMETHEUS=9090
NOHIKI_PORT_LOKI=3100
NOHIKI_PORT_TEMPO=3200
NOHIKI_PORT_MIMIR=9009
NOHIKI_PORT_PYROSCOPE=4040
NOHIKI_PORT_PHOENIX_UI=6006
NOHIKI_PORT_PHOENIX_OTLP=4320
NOHIKI_PORT_OTEL_GRPC=4317
NOHIKI_PORT_OTEL_HTTP=4318
NOHIKI_PORT_OTEL_PROM=8889
NOHIKI_PORT_OTEL_HEALTH=13133

# Advertised host URLs. Default to localhost on the ports above and track a
# remap automatically. Override the full URL only when the stack is reached
# under a different host or scheme (shared dev box, tunnel).
# NOHIKI_PUBLIC_API_URL=http://localhost:8000
# NOHIKI_S3_PUBLIC_URL=http://localhost:9002
NOHIKI_FRONTEND_ORIGIN=http://localhost:5173
