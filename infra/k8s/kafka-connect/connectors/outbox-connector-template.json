{
  "_comment": "Template for per-service outbox connectors. SERVICE_NAME and DB_PREFIX are substituted at registration time.",
  "_sync_warning": "Keep in sync with infra/k8s/helm/templates/strimzi-kafka-connectors.yaml.",
  "_tunable_rationale": {
    "heartbeat.interval.ms": "Outbox publication is low-volume; without 10s heartbeats Postgres cannot advance the replication slot's confirmed_flush_lsn and WAL accumulates on disk.",
    "snapshot.fetch.size": "Caps peak heap on Connect pods during initial outbox snapshot (Debezium default 10240). Outbox tables are tiny so the speed cost is negligible."
  },
  "name": "SERVICE_NAME-outbox",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "DATABASE_HOST",
    "database.port": "DATABASE_PORT",
    "database.user": "DATABASE_USER",
    "database.password": "DATABASE_PASSWORD",
    "database.dbname": "DATABASE_NAME",
    "topic.prefix": "DB_PREFIX",

    "plugin.name": "pgoutput",
    "slot.name": "DB_PREFIX_outbox_slot",
    "publication.name": "DB_PREFIX_outbox_pub",

    "schema.include.list": "SCHEMA_NAME",
    "table.include.list": "SCHEMA_NAME.outbox",
    "tombstones.on.delete": "false",
    "snapshot.mode": "when_needed",
    "snapshot.locking.mode": "none",
    "snapshot.fetch.size": "2048",

    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregateid",
    "transforms.outbox.table.field.event.type": "type",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.fields.additional.placement": "tracingspancontext:header:tracingspancontext,aggregatetype:header:aggregatetype",
    "transforms.outbox.route.by.field": "type",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.expand.json.payload": "false",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.debezium.converters.BinaryDataConverter",
    "value.converter.delegate.converter.type": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.delegate.converter.type.schemas.enable": "false",

    "topic.creation.enable": "true",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "3",

    "heartbeat.interval.ms": "10000",
    "poll.interval.ms": "100",
    "max.batch.size": "2048",
    "max.queue.size": "8192",

    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "errors.log.include.messages": "false",
    "errors.deadletterqueue.topic.name": "DB_PREFIX.dlq.outbox.v1",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true"
  }
}
