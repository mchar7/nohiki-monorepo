class KindctlError(RuntimeError):
    pass


def canonical_bytes(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def write_exclusive(path: Path, value: object, mode: int = 0o600) -> None:
    data = canonical_bytes(value)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)


def write_atomic(path: Path, value: object, mode: int = 0o600) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        os.fchmod(fd, mode)
        os.write(fd, canonical_bytes(value))
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(temporary_path, path)
    finally:
        if fd >= 0:
            os.close(fd)
        temporary_path.unlink(missing_ok=True)


def run_command(
    argv: Sequence[str],
    *,
    env: dict[str, str] | None = None,
    input_text: str | None = None,
    timeout: int | float | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        list(argv),
        check=False,
        capture_output=True,
        text=True,
        input=input_text,
        env=env,
        timeout=timeout,
    )
    if check and result.returncode != 0:
        stderr = result.stderr.strip()
        raise KindctlError(f"command failed ({result.returncode}): {' '.join(argv)}: {stderr}")
    return result


def command_json(argv: Sequence[str], **kwargs: Any) -> Any:
    result = run_command(argv, **kwargs)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise KindctlError(f"command did not return JSON: {' '.join(argv)}") from error


def validate_runner_path() -> None:
    source = Path(__file__)
    if source.is_symlink():
        raise KindctlError("kindctl must be invoked through its non-symlink path")
    if source.absolute().resolve() != source.absolute():
        raise KindctlError("kindctl path must resolve without symlinks")
    if REPO_ROOT.resolve() != REPO_ROOT:
        raise KindctlError("repository root must resolve without symlinks")


def validate_attempt_dir(raw: str | None) -> Path:
    if raw is None:
        raise KindctlError("this command requires --attempt-dir")
    path = Path(raw)
    if not path.is_absolute():
        raise KindctlError("--attempt-dir must be absolute")
    try:
        metadata = path.stat()
    except FileNotFoundError as error:
        raise KindctlError("--attempt-dir must already exist") from error
    if not path.is_dir() or path.is_symlink() or path.resolve() != path:
        raise KindctlError("--attempt-dir must be a canonical real directory")
    if metadata.st_uid != os.getuid():
        raise KindctlError("--attempt-dir must be owned by the invoking user")
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        raise KindctlError("--attempt-dir must have mode 0700")
    return path


def provider_environment(kubeconfig: Path | None = None) -> dict[str, str]:
    provider = os.environ.get("KIND_EXPERIMENTAL_PROVIDER", "podman")
    if provider != "podman":
        raise KindctlError("KIND_EXPERIMENTAL_PROVIDER must be podman")
    environment = os.environ | {"KIND_EXPERIMENTAL_PROVIDER": "podman"}
    if kubeconfig is not None:
        environment["KUBECONFIG"] = str(kubeconfig)
    return environment


def boot_id() -> str:
    return Path("/proc/sys/kernel/random/boot_id").read_text(encoding="ascii").strip()


def process_start_ticks(pid: int) -> int:
    fields = Path(f"/proc/{pid}/stat").read_text(encoding="ascii").split()
    return int(fields[21])


def process_matches(record: dict[str, Any]) -> bool:
    try:
        return record["bootId"] == boot_id() and process_start_ticks(int(record["pid"])) == int(record["startTicks"])
    except (FileNotFoundError, KeyError, TypeError, ValueError, ProcessLookupError):
        return False


def runtime_root() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        raise KindctlError("XDG_RUNTIME_DIR is required")
    path = Path(base) / "nohiki-kind"
    if path.exists():
        metadata = path.stat()
        if not path.is_dir() or path.is_symlink() or metadata.st_uid != os.getuid():
            raise KindctlError("runner runtime path is not a user-owned directory")
        if stat.S_IMODE(metadata.st_mode) != 0o700:
            raise KindctlError("runner runtime path must have mode 0700")
    return path


@contextlib.contextmanager
def mutation_lock(command: str, attempt: Path) -> Iterator[None]:
    root = runtime_root()
    root.mkdir(mode=0o700, exist_ok=True)
    lock_path = root / "kindctl.lock"
    descriptor = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    owner_path = root / "lock-owner.json"
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            owner = owner_path.read_text(encoding="utf-8") if owner_path.exists() else "owner record unavailable"
            raise KindctlError(f"another kindctl mutation holds the lock: {owner}") from error
        if owner_path.exists():
            try:
                stale = json.loads(owner_path.read_text(encoding="utf-8"))
            except json.JSONDecodeError as error:
                raise KindctlError("stale lock owner record is malformed") from error
            if process_matches(stale):
                raise KindctlError("live lock owner record exists without lock contention")
            owner_path.unlink()
            cleanup = attempt / "commands" / f"{command}-stale-lock.json"
            cleanup.parent.mkdir(mode=0o700, exist_ok=True)
            write_exclusive(cleanup, {"removed": stale})
        record = {
            "attempt": str(attempt),
            "bootId": boot_id(),
            "command": command,
            "pid": os.getpid(),
            "startTicks": process_start_ticks(os.getpid()),
            "startedAt": dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z"),
        }
        write_atomic(owner_path, record)
        yield
    finally:
        owner_path.unlink(missing_ok=True)
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)
        lock_path.unlink(missing_ok=True)
        try:
            root.rmdir()
        except OSError:
            pass


@contextlib.contextmanager
def command_record(command: str, attempt: Path) -> Iterator[dict[str, Any]]:
    directory = attempt / "commands"
    directory.mkdir(mode=0o700, exist_ok=True)
    output = directory / f"{command}.json"
    retry = 2
    while output.exists():
        output = directory / f"{command}-{retry}.json"
        retry += 1
    record: dict[str, Any] = {
        "command": command,
        "startedAt": dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z"),
    }
    exit_code = 1
    try:
        yield record
        exit_code = 0
    finally:
        record["finishedAt"] = dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z")
        record["exitCode"] = exit_code
        write_exclusive(output, record)


def exact_tool_version(argv: Sequence[str], expected_pattern: str, label: str) -> None:
    result = run_command(argv, timeout=10)
    output = (result.stdout + result.stderr).strip()
    if re.search(expected_pattern, output) is None:
        raise KindctlError(f"{label} version mismatch: {output}")


def preflight() -> None:
    for executable in ("kind", "kubectl", "helm", "kustomize", "flux", "flux-operator", "podman", "systemd-run"):
        if shutil.which(executable) is None:
            raise KindctlError(f"required executable is missing: {executable}")
    exact_tool_version(("kind", "version"), rf"(?<![0-9.]){re.escape(KIND_VERSION)}(?![0-9.])", "kind")
    exact_tool_version(("flux", "version", "--client"), rf"(?<![0-9.])v{re.escape(FLUX_VERSION)}(?![0-9.])", "Flux")
    exact_tool_version(("flux-operator", "version", "--client"), rf"(?<![0-9.]){re.escape(FLUX_OPERATOR_VERSION)}(?![0-9.])", "Flux Operator")
    info = command_json(("podman", "info", "--format", "json"), timeout=15)
    host = info.get("host", {})
    if bool(host.get("security", {}).get("rootless")) is not True:
        raise KindctlError("Podman must run rootless")
    if str(host.get("cgroupVersion")) != "v2" or str(host.get("cgroupManager")) != "systemd":
        raise KindctlError("Podman requires cgroup v2 with the systemd manager")
    if info.get("store", {}).get("configFile") is None:
        raise KindctlError("Podman storage metadata is unavailable")
    log_driver = str(host.get("logDriver", info.get("store", {}).get("graphDriverName", "")))
    if log_driver and log_driver != "k8s-file":
        raise KindctlError("Podman log driver must be k8s-file")
    probe = run_command(
        ("systemd-run", "--scope", "--user", "-p", "Delegate=yes", "--quiet", "sh", "-c", "cat /sys/fs/cgroup/cgroup.controllers"),
        timeout=15,
    ).stdout.split()
    if not {"cpu", "io", "memory", "pids"}.issubset(probe):
        raise KindctlError("delegated user scope lacks required cgroup controllers")
    thresholds = {
        Path("/proc/sys/kernel/pid_max"): 32768,
        Path("/proc/sys/fs/inotify/max_user_watches"): 524288,
        Path("/proc/sys/fs/inotify/max_user_instances"): 512,
    }
    for path, minimum in thresholds.items():
        if int(path.read_text(encoding="ascii")) < minimum:
            raise KindctlError(f"{path} must be at least {minimum}")
    modules = Path("/proc/modules").read_text(encoding="ascii")
    for module in ("nf_nat", "nf_tables"):
        if re.search(rf"^{module}\s", modules, re.MULTILINE) is None:
            raise KindctlError(f"kernel module is not loaded: {module}")
    if (os.cpu_count() or 0) < 16:
        raise KindctlError("at least 16 logical CPUs are required")
    memory_available = int(next(line.split()[1] for line in Path("/proc/meminfo").read_text().splitlines() if line.startswith("MemAvailable:"))) * 1024
    if memory_available < 48 * 1024**3:
        raise KindctlError("at least 48 GiB available RAM is required")
    graph_root = Path(str(info.get("store", {}).get("graphRoot", "")))
    if not graph_root.is_absolute() or shutil.disk_usage(graph_root).free < 60 * 1024**3:
        raise KindctlError("at least 60 GiB free Podman storage is required")


def kube_args(kubeconfig: Path, *args: str) -> tuple[str, ...]:
    return ("kubectl", "--kubeconfig", str(kubeconfig), *args)


def kind_clusters() -> list[str]:
    result = run_command(("kind", "get", "clusters"), env=provider_environment(), timeout=15, check=False)
    if result.returncode != 0:
        raise KindctlError(f"kind get clusters failed: {result.stderr.strip()}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def kube_contexts(kubeconfig: Path | None) -> list[str]:
    argv = ["kubectl"]
    if kubeconfig is not None and kubeconfig.exists():
        argv.extend(("--kubeconfig", str(kubeconfig)))
    argv.extend(("config", "get-contexts", "-o", "name"))
    result = run_command(argv, timeout=10, check=False)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def podman_json(argv: Sequence[str]) -> list[dict[str, Any]]:
    result = run_command(argv, timeout=10, check=False)
    if result.returncode != 0 or not result.stdout.strip():
        return []
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise KindctlError(f"Podman returned malformed JSON: {' '.join(argv)}") from error
    return value if isinstance(value, list) else [value]


def network_attachments(document: dict[str, Any]) -> list[str]:
    attachments: list[str] = []
    containers = document.get("containers", document.get("Containers", {}))
    if isinstance(containers, dict):
        for identifier, value in containers.items():
            name = value.get("name", value.get("Name", identifier)) if isinstance(value, dict) else identifier
            if CLUSTER in str(name):
                attachments.append(str(name))
    return sorted(attachments)


def current_lock_entries(root: Path, attempt: Path | None) -> set[str]:
    if attempt is None:
        return set()
    owner_path = root / "lock-owner.json"
    lock_path = root / "kindctl.lock"
    if not owner_path.is_file() or owner_path.is_symlink() or not lock_path.is_file() or lock_path.is_symlink():
        return set()
    try:
        owner = json.loads(owner_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return set()
    if (
        owner.get("attempt") != str(attempt)
        or owner.get("pid") != os.getpid()
        or not process_matches(owner)
    ):
        return set()
    return {lock_path.name, owner_path.name}


def collect_residue(kubeconfig: Path | None = None, active_attempt: Path | None = None) -> dict[str, list[str]]:
    clusters = [name for name in kind_clusters() if name == CLUSTER]
    contexts = [name for name in kube_contexts(kubeconfig) if name == CONTEXT]
    containers = podman_json(("podman", "ps", "-a", "--filter", f"label=io.x-k8s.kind.cluster={CLUSTER}", "--format", "json"))
    container_names = sorted(str(item.get("Names", item.get("Names", item.get("Id", "")))) for item in containers)
    volumes = podman_json(("podman", "volume", "ls", "--filter", f"label=io.x-k8s.kind.cluster={CLUSTER}", "--format", "json"))
    volume_names = sorted(str(item.get("Name", item.get("Driver", ""))) for item in volumes)
    network_result = run_command(("podman", "network", "inspect", "kind"), timeout=10, check=False)
    network: list[str] = []
    if network_result.returncode == 0:
        try:
            documents = json.loads(network_result.stdout)
        except json.JSONDecodeError as error:
            raise KindctlError("Podman kind network inspect returned malformed JSON") from error
        document = documents[0] if isinstance(documents, list) and documents else documents
        attachments = network_attachments(document if isinstance(document, dict) else {})
        other_clusters = [name for name in kind_clusters() if name != CLUSTER]
        if attachments or not other_clusters:
            network = attachments or ["kind"]
    proxy_state: list[str] = []
    try:
        root = runtime_root()
    except KindctlError:
        root = Path("/__nohiki_missing_runtime__")
    if root.exists():
        ignored = current_lock_entries(root, active_attempt)
        proxy_state = sorted(path.name for path in root.iterdir() if path.name not in ignored)
    api: list[str] = []
    if kubeconfig is not None and kubeconfig.exists():
        result = run_command((*kube_args(kubeconfig), "--request-timeout=2s", "get", "--raw=/version"), timeout=4, check=False)
        if result.returncode == 0:
            api = [str(kubeconfig)]
    return {
        "apiEndpoints": api,
        "containers": [name for name in container_names if name],
        "contexts": contexts,
        "kindClusters": clusters,
        "networkAttachments": network,
        "proxyState": proxy_state,
        "volumes": [name for name in volume_names if name],
    }


def require_no_residue(kubeconfig: Path | None = None, active_attempt: Path | None = None) -> dict[str, list[str]]:
    inventory = collect_residue(kubeconfig, active_attempt)
    nonempty = {key: value for key, value in inventory.items() if value}
    if nonempty:
        raise KindctlError(f"Nohiki cluster residue remains: {json.dumps(nonempty, sort_keys=True)}")
    return inventory


