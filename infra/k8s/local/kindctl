def validate_cluster(kubeconfig: Path) -> tuple[str, list[str]]:
    context = run_command(kube_args(kubeconfig, "config", "current-context"), timeout=10).stdout.strip()
    if context != CONTEXT:
        raise KindctlError(f"unexpected kubeconfig context: {context}")
    version = command_json(kube_args(kubeconfig, "get", "--raw=/version"), timeout=15)
    if version.get("gitVersion") != KUBERNETES_VERSION:
        raise KindctlError(f"Kubernetes version must be {KUBERNETES_VERSION}")
    nodes_document = command_json(kube_args(kubeconfig, "get", "nodes", "-o", "json"), timeout=15)
    nodes = nodes_document.get("items", [])
    if len(nodes) != 1:
        raise KindctlError("cluster must contain exactly one node")
    ready = next((condition for condition in nodes[0].get("status", {}).get("conditions", []) if condition.get("type") == "Ready"), None)
    if ready is None or ready.get("status") != "True":
        raise KindctlError("the sole node must be Ready")
    kube_system = command_json(kube_args(kubeconfig, "get", "namespace", "kube-system", "-o", "json"), timeout=15)
    uid = str(kube_system.get("metadata", {}).get("uid", ""))
    if not uid:
        raise KindctlError("kube-system UID is absent")
    return uid, [str(nodes[0]["metadata"]["name"])]


def repair_nodes(kubeconfig: Path) -> list[dict[str, str]]:
    nodes = [line for line in run_command(("kind", "get", "nodes", "--name", CLUSTER), env=provider_environment(kubeconfig), timeout=15).stdout.splitlines() if line]
    if not nodes:
        raise KindctlError("kind returned no nodes")
    measurements: list[dict[str, str]] = []
    for node in nodes:
        run_command(("podman", "exec", node, "sysctl", "-w", "net.ipv4.conf.all.arp_ignore=0", "net.ipv4.conf.default.arp_ignore=0"), timeout=15)
        all_value = run_command(("podman", "exec", node, "sysctl", "-n", "net.ipv4.conf.all.arp_ignore"), timeout=10).stdout.strip()
        default_value = run_command(("podman", "exec", node, "sysctl", "-n", "net.ipv4.conf.default.arp_ignore"), timeout=10).stdout.strip()
        if (all_value, default_value) != ("0", "0"):
            raise KindctlError(f"ARP repair did not persist on {node}")
        inspect = command_json(("podman", "inspect", "--type", "container", node), timeout=10)
        container = inspect[0] if isinstance(inspect, list) else inspect
        measurements.append({
            "arpIgnoreAll": all_value,
            "arpIgnoreDefault": default_value,
            "containerId": str(container.get("Id", "")),
            "hostsSha256": "",
            "name": node,
            "startTime": str(container.get("State", {}).get("StartedAt", "")),
        })
    run_command(kube_args(kubeconfig, "-n", "kube-system", "rollout", "restart", "daemonset/kindnet"), timeout=30)
    run_command(kube_args(kubeconfig, "-n", "kube-system", "rollout", "status", "daemonset/kindnet", "--timeout=120s"), timeout=125)
    run_command(kube_args(kubeconfig, "wait", "--for=condition=Ready", "nodes", "--all", "--timeout=120s"), timeout=125)
    return measurements


def require_node_pid_limits(nodes: Sequence[str]) -> dict[str, int]:
    limits: dict[str, int] = {}
    for node in nodes:
        document = command_json(("podman", "inspect", "--type", "container", node), timeout=10)
        container = document[0] if isinstance(document, list) else document
        limit = container.get("HostConfig", {}).get("PidsLimit")
        if isinstance(limit, bool) or not isinstance(limit, int) or limit <= 0:
            raise KindctlError(f"node PidsLimit must be a positive integer: {node}")
        limits[node] = limit
    return limits
def install_registry_hosts(kubeconfig: Path, nodes: Sequence[str]) -> str:
    expected_hash = hashlib.sha256(REGISTRY_HOSTS).hexdigest()
    descriptor, temporary_name = tempfile.mkstemp(prefix="nohiki-hosts-")
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        os.write(descriptor, REGISTRY_HOSTS)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        for node in nodes:
            run_command(("podman", "exec", node, "mkdir", "-p", "/etc/containerd/certs.d/localhost:5000"), timeout=10)
            run_command(("podman", "cp", str(temporary), f"{node}:/etc/containerd/certs.d/localhost:5000/hosts.toml"), timeout=15)
            run_command(("podman", "exec", node, "chmod", "0644", "/etc/containerd/certs.d/localhost:5000/hosts.toml"), timeout=10)
            mode = run_command(("podman", "exec", node, "stat", "-c", "%a", "/etc/containerd/certs.d/localhost:5000/hosts.toml"), timeout=10).stdout.strip()
            observed_hash = run_command(("podman", "exec", node, "sha256sum", "/etc/containerd/certs.d/localhost:5000/hosts.toml"), timeout=10).stdout.split()[0]
            if mode != "644" or observed_hash != expected_hash:
                raise KindctlError(f"registry hosts copy verification failed on {node}")
            run_command(kube_args(kubeconfig, "annotate", "node", node, f"nohiki.io/hosts-sha256={expected_hash}", "--overwrite"), timeout=15)
        return expected_hash
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)

def validate_runtime_control(branch: str, reviewed_sha: str) -> None:
    if RUNTIME_BRANCH.fullmatch(branch) is None:
        raise KindctlError("NOHIKI_RUNTIME_CONTROL_BRANCH is not an approved local runtime-control branch")
    if REVIEWED_SHA.fullmatch(reviewed_sha) is None:
        raise KindctlError("NOHIKI_REVIEWED_TOPIC_SHA must be a full lowercase Git SHA")
    current_branch = run_command(("git", "branch", "--show-current"), timeout=10).stdout.strip()
    local_sha = run_command(("git", "rev-parse", "HEAD"), timeout=10).stdout.strip()
    if current_branch != branch or local_sha != reviewed_sha:
        raise KindctlError("local branch and HEAD must equal the reviewed runtime-control source")
    reference = f"refs/heads/{branch}"
    remote = run_command(("git", "ls-remote", "--exit-code", "--heads", "origin", reference), timeout=30).stdout
    if remote != f"{reviewed_sha}\t{reference}\n":
        raise KindctlError("remote runtime-control branch does not equal the reviewed SHA")


def render_branch_manifest(source: Path, branch: str, destination: Path) -> str:
    if not source.is_file() or source.is_symlink() or source.resolve() != source:
        raise KindctlError(f"runtime manifest must be a canonical regular file: {source}")
    committed = source.read_text(encoding="utf-8")
    if committed.count(BRANCH_SENTINEL) != 1:
        raise KindctlError(f"runtime manifest must contain exactly one branch sentinel: {source}")
    rendered = committed.replace(BRANCH_SENTINEL, branch)
    if BRANCH_SENTINEL in rendered or rendered.replace(branch, BRANCH_SENTINEL, 1) != committed:
        raise KindctlError(f"runtime manifest changed outside its branch sentinel: {source}")
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(descriptor, rendered.encode())
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    return hashlib.sha256(rendered.encode()).hexdigest()


def runtime_binding(attempt: Path, kubeconfig: Path) -> tuple[dict[str, Any], str]:
    validate_kubeconfig_binding(attempt, kubeconfig)
    measurements_data = (attempt / "runner-measurements.json").read_bytes()
    measurements = json.loads(measurements_data)
    if not isinstance(measurements, dict) or canonical_bytes(measurements) != measurements_data:
        raise KindctlError("runner measurements are not canonical")
    context = run_command(
        kube_args(kubeconfig, "config", "current-context"),
        timeout=10,
    ).stdout.strip()
    recorded = measurements.get("cluster", {})
    if context != CONTEXT or recorded.get("context") != CONTEXT:
        raise KindctlError("kubeconfig does not target the runner context")
    namespace = command_json(
        kube_args(kubeconfig, "get", "namespace", "kube-system", "-o", "json"),
        timeout=15,
    )
    live_uid = str(namespace.get("metadata", {}).get("uid", ""))
    if not live_uid or live_uid != recorded.get("uid"):
        raise KindctlError("kubeconfig does not target the just-created cluster")
    return measurements, live_uid


def verify_runtime_artifacts() -> dict[str, str]:
    result = run_command(
        (
            "uv",
            "run",
            "--project",
            "infra/k8s/gitops",
            "python",
            str(ARTIFACT_TOOL),
            "verify",
        ),
        timeout=90,
    )
    try:
        record = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise KindctlError("Flux artifact verifier did not return JSON") from error
    if (
        not isinstance(record, dict)
        or record.get("artifactLockSha256") != sha256_file(ARTIFACT_LOCK)
    ):
        raise KindctlError("Flux artifact verification is not bound to the committed lock")
    return {str(key): str(value) for key, value in record.items()}


def apply_attempt_configmap(
    attempt: Path,
    kubeconfig: Path,
    branch: str,
    reviewed_sha: str,
    measurements: dict[str, Any],
    cluster_uid: str,
    lock_sha: str,
) -> dict[str, str]:
    attempt_number = measurements.get("attempt")
    if (
        isinstance(attempt_number, bool)
        or not isinstance(attempt_number, int)
        or attempt_number < 1
    ):
        raise KindctlError("attempt number is invalid")
    suffix = f"a{attempt_number:08d}-{cluster_uid.replace('-', '')[:8]}"
    result = run_command(
        (
            "uv",
            "run",
            "--project",
            "infra/k8s/gitops",
            "python",
            str(ATTEMPT_CONFIGMAP),
            "--attempt-suffix",
            suffix,
            "--runtime-control-branch",
            branch,
            "--source-head-sha",
            reviewed_sha,
            "--source-reviewed-sha",
            reviewed_sha,
            "--source-remote-sha",
            reviewed_sha,
            "--artifact-lock-sha256",
            lock_sha,
        ),
        timeout=15,
    )
    expected = json.loads(result.stdout)
    runtime_binding(attempt, kubeconfig)
    namespace = {
        "apiVersion": "v1",
        "kind": "Namespace",
        "metadata": {"name": "flux-system"},
    }
    run_command(
        kube_args(kubeconfig, "apply", "-f", "-"),
        input_text=canonical_bytes(namespace).decode(),
        timeout=30,
    )
    run_command(
        kube_args(kubeconfig, "apply", "-f", "-"),
        input_text=result.stdout,
        timeout=30,
    )
    observed = command_json(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "get",
            "configmap",
            "nohiki-verification-attempt",
            "-o",
            "json",
        ),
        timeout=15,
    )
    if observed.get("data") != expected.get("data"):
        raise KindctlError("mandatory Flux post-build ConfigMap was not observed")
    metadata = observed.get("metadata", {})
    uid = str(metadata.get("uid", ""))
    resource_version = str(metadata.get("resourceVersion", ""))
    if not uid or not resource_version:
        raise KindctlError("mandatory Flux post-build ConfigMap identity is absent")
    return {
        "configMapResourceVersion": resource_version,
        "configMapSha256": hashlib.sha256(canonical_bytes(expected)).hexdigest(),
        "configMapUid": uid,
    }


def flux_source_revision(kubeconfig: Path, reviewed_sha: str) -> str:
    revision = run_command(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "get",
            "gitrepository",
            "flux-system",
            "-o",
            "jsonpath={.status.artifact.revision}",
        ),
        timeout=15,
    ).stdout
    if not revision.endswith(f"sha1:{reviewed_sha}"):
        raise KindctlError("Flux source did not reach the reviewed revision")
    return revision


def wait_flux_instance(
    kubeconfig: Path,
    expected_path: str,
    reviewed_sha: str,
) -> str:
    run_command(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "wait",
            "--for=condition=Ready=True",
            "fluxinstance/flux",
            "--timeout=20m",
        ),
        timeout=1205,
    )
    instance = command_json(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "get",
            "fluxinstance",
            "flux",
            "-o",
            "json",
        ),
        timeout=15,
    )
    if instance.get("spec", {}).get("sync", {}).get("path") != expected_path:
        raise KindctlError("live FluxInstance sync path did not transition")
    uid = str(instance.get("metadata", {}).get("uid", ""))
    if not uid:
        raise KindctlError("live FluxInstance UID is absent")
    flux_source_revision(kubeconfig, reviewed_sha)
    return uid


def operator_install_once(
    attempt: Path,
    kubeconfig: Path,
    bootstrap: Path,
    reviewed_sha: str,
    expected_digest: str,
) -> str | None:
    runtime_binding(attempt, kubeconfig)
    applied = run_command(
        kube_args(kubeconfig, "apply", "-f", str(OPERATOR_INSTALL)),
        timeout=120,
        check=False,
    )
    if applied.returncode != 0:
        return None
    for crd in OPERATOR_CRDS:
        established = run_command(
            kube_args(
                kubeconfig,
                "wait",
                "--for=condition=Established",
                f"crd/{crd}",
                "--timeout=120s",
            ),
            timeout=125,
            check=False,
        )
        if established.returncode != 0:
            return None
    available = run_command(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "wait",
            "--for=condition=Available",
            "deployment/flux-operator",
            "--timeout=300s",
        ),
        timeout=305,
        check=False,
    )
    if available.returncode != 0:
        return None
    live_image = run_command(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "get",
            "deployment",
            "flux-operator",
            "-o",
            "jsonpath={.spec.template.spec.containers[0].image}",
        ),
        timeout=15,
    ).stdout
    if "@sha256:" not in live_image or not live_image.endswith(expected_digest):
        raise KindctlError("live Flux Operator image is not the verified digest")
    runtime_binding(attempt, kubeconfig)
    instance = run_command(
        kube_args(kubeconfig, "apply", "-f", str(bootstrap)),
        timeout=120,
        check=False,
    )
    if instance.returncode != 0:
        return None
    return wait_flux_instance(
        kubeconfig,
        "infra/k8s/gitops/clusters/local/bootstrap",
        reviewed_sha,
    )


def install_core_runtime(
    kubeconfig: Path,
    sync: Path,
    reviewed_sha: str,
) -> None:
    run_command(
        kube_args(kubeconfig, "apply", "-f", str(FALLBACK_INSTALL)),
        timeout=120,
    )
    for deployment in (
        "source-controller",
        "kustomize-controller",
        "helm-controller",
        "notification-controller",
    ):
        run_command(
            kube_args(
                kubeconfig,
                "-n",
                "flux-system",
                "wait",
                "--for=condition=Available",
                f"deployment/{deployment}",
                "--timeout=300s",
            ),
            timeout=305,
        )
    run_command(kube_args(kubeconfig, "apply", "-f", str(sync)), timeout=120)
    run_command(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "wait",
            "--for=condition=Ready=True",
            "kustomization/flux-system",
            "--timeout=20m",
        ),
        timeout=1205,
    )
    flux_source_revision(kubeconfig, reviewed_sha)


def qualify_flux_runtime(
    kubeconfig: Path,
    attempt: Path,
    direction: Literal["operator-to-core", "core-to-operator"],
) -> dict[str, str]:
    branch = os.environ.get("NOHIKI_RUNTIME_CONTROL_BRANCH", "")
    reviewed_sha = os.environ.get("NOHIKI_REVIEWED_TOPIC_SHA", "")
    validate_runtime_control(branch, reviewed_sha)
    measurements, cluster_uid = runtime_binding(attempt, kubeconfig)
    artifacts = verify_runtime_artifacts()
    configmap = apply_attempt_configmap(
        attempt,
        kubeconfig,
        branch,
        reviewed_sha,
        measurements,
        cluster_uid,
        artifacts["artifactLockSha256"],
    )
    render_root = attempt / "runtime" / "flux-rendered"
    bootstrap = render_root / "flux-instance-bootstrap.yaml"
    sync = render_root / "fallback-sync.yaml"
    bootstrap_hash = render_branch_manifest(BOOTSTRAP_INSTANCE, branch, bootstrap)
    sync_hash = render_branch_manifest(FALLBACK_SYNC, branch, sync)

    def select_core() -> None:
        install_core_runtime(kubeconfig, sync, reviewed_sha)

    if direction == "core-to-operator":
        select_core()
    instance_uid = operator_install_once(
        attempt,
        kubeconfig,
        bootstrap,
        reviewed_sha,
        artifacts["operatorImageDigest"],
    )
    if instance_uid is None:
        select_core()
        selected = "core"
        instance_uid = ""
    else:
        selected = "operator"
    return {
        "bootstrapFluxInstanceUid": instance_uid,
        "bootstrapSha256": bootstrap_hash,
        **configmap,
        "direction": direction,
        "selected": selected,
        "syncSha256": sync_hash,
    }


def validate_publication_record(
    attempt: Path,
    path: Path,
    reviewed_sha: str,
) -> dict[str, Any]:
    if path != attempt / "publication.json" or path.resolve() != path:
        raise KindctlError("publication record is not the canonical attempt path")
    data = path.read_bytes()
    sidecar_data = (attempt / "publication.sha256.json").read_bytes()
    record = json.loads(data)
    sidecar = json.loads(sidecar_data)
    if not isinstance(record, dict) or canonical_bytes(record) != data:
        raise KindctlError("publication record is not canonical")
    if (
        not isinstance(sidecar, dict)
        or canonical_bytes(sidecar) != sidecar_data
        or sidecar.get("sha256") != hashlib.sha256(data).hexdigest()
    ):
        raise KindctlError("publication sidecar does not bind its record")
    if (
        record.get("sourceSha") != reviewed_sha
        or record.get("publicationSha") != reviewed_sha
        or record.get("remoteSha") != reviewed_sha
        or record.get("lockSha256") != sha256_file(ARTIFACT_LOCK)
    ):
        raise KindctlError(
            "publication record does not bind the reviewed source and runtime lock"
        )
    return record


def finalize_flux_runtime(
    kubeconfig: Path,
    attempt: Path,
    publication_record: Path,
) -> dict[str, str]:
    branch = os.environ.get("NOHIKI_RUNTIME_CONTROL_BRANCH", "")
    reviewed_sha = os.environ.get("NOHIKI_REVIEWED_TOPIC_SHA", "")
    validate_runtime_control(branch, reviewed_sha)
    validate_publication_record(attempt, publication_record, reviewed_sha)
    runtime_binding(attempt, kubeconfig)
    configmap = command_json(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "get",
            "configmap",
            "nohiki-verification-attempt",
            "-o",
            "json",
        ),
        timeout=15,
    )
    if not configmap.get("metadata", {}).get("uid"):
        raise KindctlError("mandatory Flux post-build ConfigMap is absent")
    render_root = attempt / "runtime" / "flux-rendered"
    final = render_root / "flux-instance.yaml"
    final_hash = render_branch_manifest(FINAL_INSTANCE, branch, final)
    before = command_json(
        kube_args(
            kubeconfig,
            "-n",
            "flux-system",
            "get",
            "fluxinstance",
            "flux",
            "-o",
            "json",
        ),
        timeout=15,
    )
    before_uid = str(before.get("metadata", {}).get("uid", ""))
    if (
        before.get("spec", {}).get("sync", {}).get("path")
        != "infra/k8s/gitops/clusters/local/bootstrap"
    ):
        raise KindctlError("final handoff did not begin from the bootstrap root")
    run_command(kube_args(kubeconfig, "apply", "-f", str(final)), timeout=120)
    after_uid = wait_flux_instance(
        kubeconfig,
        "infra/k8s/gitops/clusters/local",
        reviewed_sha,
    )
    if not before_uid or after_uid != before_uid:
        raise KindctlError("final handoff replaced the FluxInstance")
    source_revision = flux_source_revision(kubeconfig, reviewed_sha)
    verification_deadline: float | None = None
    for child in FULL_CHILDREN:
        if child == "health-verification":
            verification_deadline = time.monotonic() + 3600
        if verification_deadline is None:
            timeout_seconds = 1205
            timeout_argument = "20m"
        else:
            timeout_seconds = max(1, int(verification_deadline - time.monotonic()))
            timeout_argument = f"{timeout_seconds}s"
        run_command(
            kube_args(
                kubeconfig,
                "-n",
                "flux-system",
                "wait",
                "--for=condition=Ready=True",
                f"kustomization/{child}",
                f"--timeout={timeout_argument}",
            ),
            timeout=timeout_seconds + 5,
        )
        state = command_json(
            kube_args(
                kubeconfig,
                "-n",
                "flux-system",
                "get",
                "kustomization",
                child,
                "-o",
                "json",
            ),
            timeout=15,
        )
        if state.get("metadata", {}).get("generation") != state.get(
            "status", {}
        ).get("observedGeneration"):
            raise KindctlError(f"Flux child generation is stale: {child}")
        if state.get("status", {}).get("lastAppliedRevision") != source_revision:
            raise KindctlError(f"Flux child revision is stale: {child}")
    return {
        "finalSha256": final_hash,
        "fluxInstanceUid": after_uid,
        "sourceRevision": source_revision,
    }


def qualify_offline_policy(kubeconfig: Path, attempt: Path) -> dict[str, str]:
    runtime_binding(attempt, kubeconfig)
    nodes = [
        line
        for line in run_command(
            ("kind", "get", "nodes", "--name", CLUSTER),
            env=provider_environment(kubeconfig),
            timeout=15,
        ).stdout.splitlines()
        if line
    ]
    if not nodes:
        raise KindctlError("kind returned no nodes for offline qualification")
    policy = OFFLINE_EGRESS.read_text(encoding="utf-8")
    loaded: list[str] = []
    try:
        for node in nodes:
            run_command(
                ("podman", "exec", "-i", node, "nft", "-c", "-f", "-"),
                input_text=policy,
                timeout=15,
            )
            run_command(
                ("podman", "exec", "-i", node, "nft", "-f", "-"),
                input_text=policy,
                timeout=15,
            )
            loaded.append(node)
            observed = run_command(
                (
                    "podman",
                    "exec",
                    node,
                    "nft",
                    "-a",
                    "list",
                    "table",
                    "inet",
                    "nohiki_offline",
                ),
                timeout=15,
            ).stdout
            if observed.count("policy drop") != 2 or observed.count("counter") < 2:
                raise KindctlError(f"offline policy was not observed on {node}")
        return {"nodes": ",".join(nodes), "policySha256": sha256_file(OFFLINE_EGRESS)}
    finally:
        for node in loaded:
            removed = run_command(
                (
                    "podman",
                    "exec",
                    node,
                    "nft",
                    "delete",
                    "table",
                    "inet",
                    "nohiki_offline",
                ),
                timeout=15,
                check=False,
            )
            if removed.returncode != 0:
                raise KindctlError(f"offline policy cleanup failed on {node}")




def require_storage_class(kubeconfig: Path) -> dict[str, str]:
    document = command_json(kube_args(kubeconfig, "get", "storageclass", "standard", "-o", "json"), timeout=15)
    metadata = document.get("metadata", {})
    annotations = metadata.get("annotations", {})
    if annotations.get("storageclass.kubernetes.io/is-default-class") != "true":
        raise KindctlError("standard StorageClass must be default")
    expected = {"provisioner": "rancher.io/local-path", "volumeBindingMode": "WaitForFirstConsumer", "reclaimPolicy": "Delete"}
    actual = {key: str(document.get(key, "")) for key in expected}
    if actual != expected:
        raise KindctlError(f"standard StorageClass mismatch: {actual}")
    return actual


def storage_probe(kubeconfig: Path) -> dict[str, str]:
    nonce = hashlib.sha256(os.urandom(32)).hexdigest()
    manifest = f"""apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nohiki-storage-probe
spec:
  storageClassName: standard
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 64Mi
---
apiVersion: v1
kind: Pod
metadata:
  name: nohiki-storage-writer
spec:
  restartPolicy: Never
  containers:
    - name: probe
      image: docker.io/library/alpine:3.22
      command: [sh, -c, "printf %s {nonce} > /data/nonce"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: nohiki-storage-probe
"""
    run_command(kube_args(kubeconfig, "apply", "-f", "-"), input_text=manifest, timeout=30)
    try:
        run_command(kube_args(kubeconfig, "wait", "--for=jsonpath={.status.phase}=Succeeded", "pod/nohiki-storage-writer", "--timeout=120s"), timeout=125)
        claim = command_json(kube_args(kubeconfig, "get", "pvc", "nohiki-storage-probe", "-o", "json"), timeout=15)
        volume_name = str(claim.get("spec", {}).get("volumeName", ""))
        capacity = str(claim.get("status", {}).get("capacity", {}).get("storage", ""))
        if claim.get("status", {}).get("phase") != "Bound" or not volume_name or not capacity:
            raise KindctlError("storage probe claim did not bind")
        run_command(kube_args(kubeconfig, "delete", "pod", "nohiki-storage-writer", "--wait=true", "--timeout=60s"), timeout=65)
        reader = """apiVersion: v1
kind: Pod
metadata:
  name: nohiki-storage-reader
spec:
  restartPolicy: Never
  containers:
    - name: probe
      image: docker.io/library/alpine:3.22
      command: [sh, -c, "cat /data/nonce"]
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: nohiki-storage-probe
"""
        run_command(kube_args(kubeconfig, "apply", "-f", "-"), input_text=reader, timeout=30)
        run_command(kube_args(kubeconfig, "wait", "--for=jsonpath={.status.phase}=Succeeded", "pod/nohiki-storage-reader", "--timeout=120s"), timeout=125)
        observed = run_command(kube_args(kubeconfig, "logs", "pod/nohiki-storage-reader", "-c", "probe"), timeout=15).stdout.strip()
        if observed != nonce:
            raise KindctlError("storage nonce changed across Pod recreation")
        return {"accessModes": "ReadWriteOnce", "capacity": capacity, "persistentVolume": volume_name, "storageClass": "standard"}
    finally:
        run_command(kube_args(kubeconfig, "delete", "pod", "nohiki-storage-writer", "nohiki-storage-reader", "--ignore-not-found", "--wait=true", "--timeout=60s"), timeout=65, check=False)
        claim = run_command(kube_args(kubeconfig, "get", "pvc", "nohiki-storage-probe", "-o", "json"), timeout=15, check=False)
        volume_name = ""
        if claim.returncode == 0:
            try:
                volume_name = str(json.loads(claim.stdout).get("spec", {}).get("volumeName", ""))
            except json.JSONDecodeError:
                pass
        run_command(kube_args(kubeconfig, "delete", "pvc", "nohiki-storage-probe", "--ignore-not-found", "--wait=true", "--timeout=60s"), timeout=65, check=False)
        if volume_name:
            result = run_command(kube_args(kubeconfig, "wait", "--for=delete", f"pv/{volume_name}", "--timeout=120s"), timeout=125, check=False)
            if result.returncode != 0:
                raise KindctlError("storage probe PersistentVolume was not deleted")


def network_probe(kubeconfig: Path) -> dict[str, bool]:
    manifest = """apiVersion: v1
kind: Pod
metadata:
  name: nohiki-network-a
spec:
  restartPolicy: Never
  containers:
    - name: probe
      image: docker.io/library/alpine:3.22
      command: [sleep, "3600"]
---
apiVersion: v1
kind: Pod
metadata:
  name: nohiki-network-b
spec:
  restartPolicy: Never
  containers:
    - name: probe
      image: docker.io/library/alpine:3.22
      command: [sleep, "3600"]
"""
    run_command(kube_args(kubeconfig, "apply", "-f", "-"), input_text=manifest, timeout=30)
    try:
        run_command(kube_args(kubeconfig, "wait", "--for=condition=Ready", "pod/nohiki-network-a", "pod/nohiki-network-b", "--timeout=120s"), timeout=125)
        pod_b = command_json(kube_args(kubeconfig, "get", "pod", "nohiki-network-b", "-o", "json"), timeout=15)
        pod_ip = str(pod_b.get("status", {}).get("podIP", ""))
        node = command_json(kube_args(kubeconfig, "get", "node", "nohiki-control-plane", "-o", "json"), timeout=15)
        node_ip = next((str(item["address"]) for item in node.get("status", {}).get("addresses", []) if item.get("type") == "InternalIP"), "")
        probes = {
            "dns": ("nslookup", "kubernetes.default.svc.cluster.local"),
            "nodeApi": ("wget", "-qO-", "--no-check-certificate", f"https://{node_ip}:6443/version"),
            "podIp": ("ping", "-c", "1", "-W", "2", pod_ip),
            "serviceVersion": ("wget", "-qO-", "--no-check-certificate", "https://10.96.0.1/version"),
        }
        results = {
            name: run_command(kube_args(kubeconfig, "exec", "nohiki-network-a", "--", *argv), timeout=15, check=False).returncode == 0
            for name, argv in probes.items()
        }
        if not all(results.values()):
            raise KindctlError(f"stock kind network probe failed: {results}")
        return results
    finally:
        run_command(kube_args(kubeconfig, "delete", "pod", "nohiki-network-a", "nohiki-network-b", "--ignore-not-found", "--wait=true", "--timeout=60s"), timeout=65, check=False)


def write_measurements(attempt: Path, kubeconfig: Path, cluster_uid: str, nodes: list[dict[str, str]], network: dict[str, bool], storage: dict[str, str]) -> None:
    metadata = kubeconfig.stat()
    document = {
        "apiVersion": "nohiki.io/v1alpha1",
        "attempt": int(re.search(r"(\d+)$", attempt.name).group(1)) if re.search(r"(\d+)$", attempt.name) else 1,
        "cluster": {"context": CONTEXT, "name": CLUSTER, "uid": cluster_uid},
        "kubeconfig": {"device": metadata.st_dev, "inode": metadata.st_ino, "mode": "0600", "owner": metadata.st_uid, "path": str(kubeconfig)},
        "kind": "KindctlMeasurements",
        "lockSha256": sha256_file(CONFIG),
        "network": network,
        "nodes": nodes,
        "schemaVersion": 1,
        "secrets": [],
        "source": {"branch": None, "remoteSha": None, "reviewedSha": None},
        "storage": storage,
    }
    output = attempt / "runner-measurements.json"
    sidecar = attempt / "runner-measurements.sha256.json"
    write_exclusive(output, document)
    write_exclusive(sidecar, {"attempt": document["attempt"], "clusterUid": cluster_uid, "lockSha256": document["lockSha256"], "sha256": sha256_file(output)})


def validate_kubeconfig_binding(attempt: Path, kubeconfig: Path) -> None:
    measurements_path = attempt / "runner-measurements.json"
    sidecar_path = attempt / "runner-measurements.sha256.json"
    if any(path.is_symlink() or not path.is_file() for path in (measurements_path, sidecar_path)):
        raise KindctlError("delete requires runner measurement and sidecar files")
    measurements_bytes = measurements_path.read_bytes()
    measurements = json.loads(measurements_bytes)
    sidecar = json.loads(sidecar_path.read_bytes())
    if canonical_bytes(measurements) != measurements_bytes or canonical_bytes(sidecar) != sidecar_path.read_bytes():
        raise KindctlError("runner measurement inputs must be canonical JSON")
    if sidecar.get("sha256") != hashlib.sha256(measurements_bytes).hexdigest():
        raise KindctlError("runner measurement sidecar hash does not match")
    binding = measurements.get("kubeconfig", {})
    metadata = kubeconfig.stat()
    actual = {
        "device": metadata.st_dev,
        "inode": metadata.st_ino,
        "mode": f"{stat.S_IMODE(metadata.st_mode):04o}",
        "owner": metadata.st_uid,
        "path": str(kubeconfig),
    }
    if binding != actual or actual["owner"] != os.getuid() or actual["mode"] != "0600":
        raise KindctlError("runner-owned kubeconfig identity changed")


def create(attempt: Path) -> dict[str, Any]:
    runtime = attempt / "runtime"
    kubeconfig = runtime / "kubeconfig"
    measurements = (attempt / "runner-measurements.json", attempt / "runner-measurements.sha256.json")
    if runtime.exists():
        if any(path.exists() for path in measurements):
            raise KindctlError("a completed runner attempt cannot be created again")
        cleanup_cluster(attempt)
    require_no_residue(kubeconfig, attempt)
    preflight()
    runtime.mkdir(mode=0o700)
    descriptor = os.open(kubeconfig, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    os.close(descriptor)
    try:
        run_command(create_argv(kubeconfig), timeout=CREATE_TIMEOUT)
        validate_owned_kubeconfig(kubeconfig)
        cluster_uid, cluster_nodes = validate_cluster(kubeconfig)
        nodes = repair_nodes(kubeconfig)
        pids_limits = require_node_pid_limits(cluster_nodes)
        require_storage_class(kubeconfig)
        network = network_probe(kubeconfig)
        storage = storage_probe(kubeconfig)
        write_measurements(attempt, kubeconfig, cluster_uid, nodes, network, storage)
        return {"nodePidsLimits": pids_limits}
    except BaseException as create_error:
        try:
            cleanup_cluster(attempt)
        except BaseException as cleanup_error:
            raise KindctlError(f"create failed ({create_error}); cleanup failed ({cleanup_error})") from cleanup_error
        raise


def diagnostics(attempt: Path | None, kubeconfig: Path | None) -> dict[str, Any]:
    commands: list[tuple[str, ...]] = [
        ("kind", "get", "clusters"),
        ("podman", "ps", "-a", "--format", "json"),
        ("podman", "network", "inspect", "kind"),
    ]
    if kubeconfig is not None and kubeconfig.exists():
        commands.extend((
            kube_args(kubeconfig, "get", "nodes", "-o", "wide"),
            kube_args(kubeconfig, "get", "pods", "-A", "-o", "wide"),
            kube_args(kubeconfig, "get", "events", "-A", "--sort-by=.lastTimestamp"),
            kube_args(kubeconfig, "-n", "flux-system", "get", "fluxinstances,fluxreports", "-o", "wide"),
            kube_args(kubeconfig, "-n", "flux-system", "get", "gitrepositories,kustomizations", "-o", "wide"),
            kube_args(kubeconfig, "-n", "flux-system", "get", "deployments", "-o", "wide"),
            kube_args(kubeconfig, "get", "pvc", "-A", "-o", "wide"),
        ))
    entries = []
    for argv in commands:
        result = run_command(argv, timeout=15, check=False)
        entries.append({"argv": list(argv), "exitCode": result.returncode, "stderr": result.stderr, "stdout": result.stdout})
    document = {"command": "diagnostics", "entries": entries, "observedAt": dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z")}
    if attempt is not None:
        directory = attempt / "diagnostics"
        directory.mkdir(mode=0o700, exist_ok=True)
        name = f"diagnostics-{time.time_ns()}.json"
        write_exclusive(directory / name, document)
    return document


def validate_runtime_dir(runtime: Path) -> None:
    metadata = runtime.stat()
    if (
        not runtime.is_dir()
        or runtime.is_symlink()
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise KindctlError("runner-owned runtime must be a user-owned mode-0700 directory")


def validate_owned_kubeconfig(kubeconfig: Path) -> None:
    metadata = kubeconfig.stat()
    if (
        not kubeconfig.is_file()
        or kubeconfig.is_symlink()
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise KindctlError("runner-owned kubeconfig must be a user-owned mode-0600 file")


def delete_argv(kubeconfig: Path) -> tuple[str, ...]:
    return (
        "systemd-run", "--scope", "--user", "-p", "Delegate=yes", "env",
        "KIND_EXPERIMENTAL_PROVIDER=podman", f"KUBECONFIG={kubeconfig}",
        "kind", "delete", "cluster", "--name", CLUSTER, "--kubeconfig", str(kubeconfig),
    )


def remove_unused_kind_network() -> None:
    remaining = [name for name in kind_clusters() if name != CLUSTER]
    network = run_command(("podman", "network", "inspect", "kind"), timeout=10, check=False)
    if network.returncode != 0:
        return
    try:
        documents = json.loads(network.stdout)
    except json.JSONDecodeError as error:
        raise KindctlError("Podman kind network inspect returned malformed JSON") from error
    document = documents[0] if isinstance(documents, list) and documents else documents
    attachments = network_attachments(document if isinstance(document, dict) else {})
    if any(CLUSTER in item for item in attachments):
        raise KindctlError("Nohiki endpoint remains attached to the kind network")
    if not remaining and not attachments:
        run_command(("podman", "network", "rm", "kind"), timeout=15)


def require_cluster_absent(kubeconfig: Path, attempt: Path) -> None:
    inventory = collect_residue(kubeconfig, attempt)
    inventory["contexts"] = []
    nonempty = {key: value for key, value in inventory.items() if value}
    if nonempty:
        raise KindctlError(f"Nohiki cluster residue remains: {json.dumps(nonempty, sort_keys=True)}")


def cleanup_cluster(attempt: Path) -> None:
    runtime = attempt / "runtime"
    kubeconfig = runtime / "kubeconfig"
    if runtime.exists():
        validate_runtime_dir(runtime)
    if kubeconfig.exists():
        validate_owned_kubeconfig(kubeconfig)
    diagnostics(attempt, kubeconfig if kubeconfig.exists() else None)
    if CLUSTER in kind_clusters():
        if not kubeconfig.exists():
            raise KindctlError("cannot delete the Nohiki cluster without its runner-owned kubeconfig")
        try:
            run_command(delete_argv(kubeconfig), timeout=DELETE_TIMEOUT)
        except BaseException:
            diagnostics(attempt, kubeconfig)
            raise
    remove_unused_kind_network()
    if kubeconfig.exists():
        require_cluster_absent(kubeconfig, attempt)
    if runtime.exists():
        shutil.rmtree(runtime)
    require_no_residue(None, attempt)


def delete(attempt: Path) -> None:
    runtime = attempt / "runtime"
    kubeconfig = runtime / "kubeconfig"
    measurements = (attempt / "runner-measurements.json", attempt / "runner-measurements.sha256.json")
    present_measurements = [path.exists() for path in measurements]
    if any(present_measurements) and not all(present_measurements):
        raise KindctlError("delete requires both runner measurement files or neither")
    if runtime.exists():
        validate_runtime_dir(runtime)
    if kubeconfig.exists():
        validate_owned_kubeconfig(kubeconfig)
        if all(present_measurements):
            validate_kubeconfig_binding(attempt, kubeconfig)
    elif CLUSTER in kind_clusters():
        raise KindctlError("cannot delete the Nohiki cluster without its runner-owned kubeconfig")
    cleanup_cluster(attempt)


def parse_arguments(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="kindctl")
    parser.add_argument("--attempt-dir")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("preflight")
    subparsers.add_parser("create")
    subparsers.add_parser("diagnostics")
    observe_parser = subparsers.add_parser("observe")
    observe_parser.add_argument("observer_args", nargs=argparse.REMAINDER)
    subparsers.add_parser("delete")
    subparsers.add_parser("residue")
    runtime_parser = subparsers.add_parser("flux-runtime")
    runtime_parser.add_argument(
        "--direction",
        choices=("operator-to-core", "core-to-operator"),
        required=True,
    )
    finalize_parser = subparsers.add_parser("flux-finalize")
    finalize_parser.add_argument("--publication-record", type=Path, required=True)
    subparsers.add_parser("flux-offline")
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    validate_runner_path()
    arguments = parse_arguments(sys.argv[1:] if argv is None else argv)
    if arguments.command == "observe":
        forwarded = arguments.observer_args
        if not forwarded or forwarded[0] != "--":
            raise KindctlError("observe requires an argument separator: kindctl observe -- <observer argv>")
        os.execv(OBSERVER, [str(OBSERVER), *forwarded[1:]])
    attempt = validate_attempt_dir(arguments.attempt_dir) if arguments.attempt_dir else None
    if arguments.command == "preflight":
        preflight()
    elif arguments.command == "diagnostics":
        document = diagnostics(attempt, (attempt / "runtime/kubeconfig") if attempt else None)
        if attempt is None:
            print(json.dumps(document, sort_keys=True))
    elif arguments.command == "residue":
        kubeconfig = (attempt / "runtime/kubeconfig") if attempt else None
        print(json.dumps(require_no_residue(kubeconfig), sort_keys=True))
    elif arguments.command in {
        "create",
        "delete",
        "flux-runtime",
        "flux-finalize",
        "flux-offline",
    }:
        if attempt is None:
            raise KindctlError(f"{arguments.command} requires --attempt-dir")
        with mutation_lock(arguments.command, attempt), command_record(
            arguments.command,
            attempt,
        ) as record:
            kubeconfig = attempt / "runtime/kubeconfig"
            if arguments.command == "create":
                record.update(create(attempt))
            elif arguments.command == "delete":
                delete(attempt)
            elif arguments.command == "flux-runtime":
                record.update(
                    qualify_flux_runtime(
                        kubeconfig,
                        attempt,
                        arguments.direction,
                    )
                )
            elif arguments.command == "flux-finalize":
                record.update(
                    finalize_flux_runtime(
                        kubeconfig,
                        attempt,
                        arguments.publication_record,
                    )
                )
            else:
                record.update(qualify_offline_policy(kubeconfig, attempt))
            record["result"] = "passed"
    else:
        raise KindctlError(f"unsupported command: {arguments.command}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KindctlError, subprocess.TimeoutExpired, OSError, ValueError) as error:
        print(f"kindctl: {error}", file=sys.stderr)
        raise SystemExit(1) from error
