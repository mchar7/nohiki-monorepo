        "overrides": [
          {
            "matcher": {
              "id": "byValue",
              "options": {
                "reducer": "lastNotNull",
                "type": "range",
                "from": null,
                "to": 10
              }
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
