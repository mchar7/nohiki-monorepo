              {"color": "yellow", "value": 500},
              {"color": "red", "value": 1000}
            ]
          },
          "unit": "ms",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byValue",
              "options": {
                "reducer": "lastNotNull",
                "type": "range",
                "from": null,
                "to": 10
              }
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
